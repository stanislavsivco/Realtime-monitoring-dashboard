# Copy this file to .env and fill in the values before starting the backend.
# Never commit .env to Git.

# --- Database ---
DB_URL=jdbc:postgresql://localhost:5432/rmd
DB_USERNAME=postgres
DB_PASSWORD=

# --- JWT ---
# Minimum 32 characters, random string.
JWT_SECRET=

# --- Initial admin account (created once on first startup) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
