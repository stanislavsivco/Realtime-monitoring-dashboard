# Copy this file to .env and fill in the values before starting the backend.
# Never commit .env to Git.

# --- Database ---
DB_URL=jdbc:postgresql://localhost:5432/rmd
DB_USERNAME=postgres
DB_PASSWORD=

# --- JWT ---
# Minimum 32 bytes (UTF-8), random string. The backend refuses to start with a shorter value.
JWT_SECRET=
# Token lifetime in milliseconds. Optional, default 86400000 (24 hours).
JWT_EXPIRATION_MS=86400000

# --- Initial admin account (created once on first startup) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- Frontend (CORS) ---
# One or more origins separated by commas, without trailing slash. Wildcard '*' is not allowed.
FRONTEND_ORIGIN=http://localhost:4200

# --- Agent API key (sent in X-Agent-Key header by the Python agent) ---
# Minimum 32 bytes (UTF-8), random string. The backend refuses to start with a shorter value.
AGENT_API_KEY=

# --- Logging ---
# Log every SQL statement. Use true only for local debugging.
SHOW_SQL=false

# --- Demo data ---
# true = create demo devices on an empty database and generate fake metrics every 10 seconds. Keep false in production.
SIMULATION_ENABLED=false

# --- Metric retention ---
# Metrics older than this many days are deleted every hour. Minimum 1.
METRIC_RETENTION_DAYS=7

# --- Rate limiting per IP address ---
LOGIN_RATE_LIMIT_PER_MINUTE=10
REGISTER_RATE_LIMIT_PER_HOUR=5
# native = trust X-Forwarded-For only from internal proxy addresses (Render). none = always use the direct client address.
FORWARD_HEADERS_STRATEGY=native
