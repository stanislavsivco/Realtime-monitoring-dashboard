# Copy this file to .env and fill in the values before starting the backend.
# Never commit .env to Git.

# How to run database:
#   cd devops
#   cp ../.env.example .env (skip this if devops/.env already exists, it would be overwritten)
#   open devops/.env in an editor and fill in the values
#   Always fill: JWT_SECRET, ADMIN_PASSWORD, AGENT_API_KEY
#   Neon database:   fill DB_URL, DB_USERNAME, DB_PASSWORD
#                    docker compose up --build
#   Local database:  fill LOCAL_DB_USERNAME, LOCAL_DB_PASSWORD
#                    docker compose -f docker-compose.yml -f docker-compose.local-db.yml up --build
#
# Changing LOCAL_DB_USERNAME or LOCAL_DB_PASSWORD after the local database was created has no
# effect until the volume is recreated:
#   docker compose -f docker-compose.yml -f docker-compose.local-db.yml down -v
# Warning: down -v deletes all data in the local database.

# --- Database ---
# JDBC URL from the Neon dashboard, it must end with ?sslmode=require.
# Leave empty when you only use the local database.
DB_URL=
DB_USERNAME=postgres
DB_PASSWORD=

# --- Local Database --- #
LOCAL_DB_USERNAME=postgres
LOCAL_DB_PASSWORD=

# --- JWT ---
# Minimum 32 bytes (UTF-8), random string. The backend refuses to start with a shorter value.
JWT_SECRET=
# Token lifetime in milliseconds. Optional, default 86400000 (24 hours).
JWT_EXPIRATION_MS=86400000

# --- Initial admin account (created once on first startup) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- Frontend (CORS) ---
# One or more origins separated by commas, without trailing slash. Wildcard '*' is not allowed.
FRONTEND_ORIGIN=http://localhost:4200

# --- Agent API key (sent in X-Agent-Key header by the Python agent) ---
# Minimum 32 bytes (UTF-8), random string. The backend refuses to start with a shorter value.
AGENT_API_KEY=

# --- Logging ---
# Log every SQL statement. Use true only for local debugging.
SHOW_SQL=false
