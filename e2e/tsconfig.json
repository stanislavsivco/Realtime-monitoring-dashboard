{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "noEmit": true,
        "types": [ "node" ]
    },
    "include": [ "env.ts", "playwright.config.ts", "tests/**/*.ts" ]
}